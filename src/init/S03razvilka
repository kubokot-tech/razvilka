#!/bin/sh
# razvilka: маршрутизация (сторож в cron достроит, когда поднимется VPN)
case "$1" in
    start|restart) exec /opt/razvilka/razvilka.sh service-start ;;
    stop)          exec /opt/razvilka/razvilka.sh service-stop ;;
    status)        exec /opt/razvilka/razvilka.sh status ;;
    *) echo "usage: $0 start|stop|restart|status"; exit 1 ;;
esac
