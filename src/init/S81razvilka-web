#!/bin/sh
# Отдельный экземпляр lighttpd для панели и заглушки.
PIDF=/opt/var/run/razvilka-web.pid
CONF=/opt/razvilka/lighttpd.conf
running() {
    [ -r "$PIDF" ] || return 1
    pid=$(cat "$PIDF")
    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = lighttpd ] &&
        tr '\000' '\n' < "/proc/$pid/cmdline" | grep -qxF "$CONF"
}
case "$1" in
    start)
        /opt/razvilka/razvilka.sh alias-on || exit 1
        unset LOCK_HELD
        running || /opt/sbin/lighttpd -f "$CONF"
        ;;
    stop)
        if running; then
            kill "$pid" || exit 1
            count=0
            while running; do
                [ "$count" -lt 5 ] || exit 1
                sleep 1; count=$((count + 1))
            done
        fi
        rm -f "$PIDF" ;;
    restart) "$0" stop && "$0" start ;;
    status) if running; then echo "работает"; else echo "остановлен"; exit 1; fi ;;
    *) echo "usage: $0 start|stop|restart|status" >&2; exit 1 ;;
esac
